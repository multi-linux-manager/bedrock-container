IMAGE="ghcr.io/multi-linux-manager/bedrock-container:latest"

if ! command -v podman >/dev/null 2>&1; then
  echo "ERROR: Can't find the podman comand (most likely it is not installed)"
fi

DIRECTORY="${PWD}"

usage() {
  echo "Usage: $(basename "$0") [-d <path>] [-h]"
  echo "  -d <path>         Path to the directory that will be availble as" 
  echo "                    /home/bedrock/code inside the container"
  echo "                    (default: current directory)"
  echo "  -h                Show this help"
}

while getopts ":d:h" opt; do
  case ${opt} in
    d) DIRECTORY="${OPTARG}" ;;
    h) usage; exit 0 ;;
    :) echo "ERROR: Option -${OPTARG} requires an argument"; usage; exit 1 ;;
    \?) echo "ERROR: Invalid option -${OPTARG}"; usage; exit 1 ;;
  esac
done

if [ ! -d "${DIRECTORY}" ]; then
  echo "ERROR: ${DIRECTORY} is not a directory"
  exit 1
fi
DIRECTORY=$(cd -P "${DIRECTORY}" &> /dev/null && pwd)

podman pull ${IMAGE}
podman run --userns=keep-id -ti --rm -v bedrock-aws:/home/bedrock/.aws -v bedrock-clause:/home/bedrock/.claude -v "${DIRECTORY}/":/home/bedrock/code:Z ${IMAGE}
